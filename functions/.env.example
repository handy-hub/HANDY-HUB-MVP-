# functions/.env.example — commit this file, not .env
# Copy to .env and fill in your values for local development.

CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ── Email OTP (pick ONE provider) ────────────────────────────────────────────
# Option A — Resend (recommended): https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Option B — SendGrid: https://sendgrid.com
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx

# Sender address (must be verified in your chosen provider's dashboard)
EMAIL_FROM=noreply@handyhub.app
